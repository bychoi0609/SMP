# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite local db
*.db
*.db-journal

# scratchpad(디버그 스크립트 임시 산출물) - 원본 메일 HTML 등 민감정보 포함 가능
/scratchpad/

.vercel
.env*

# 실제 거래 자료(한전 요금안내 PDF, 세금계산서 생성 결과, 매칭데이터 등) - 사업자정보 포함, 커밋 금지
# 앱이 런타임에 읽는 빈양식_월데이.xlsx만 예외로 추적한다.
/output/
/양식/*
!/양식/빈양식_월데이.xlsx
